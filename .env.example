# Copy this file to .env and fill in real values.

# --- Database ---
DATABASE_URL=sqlite:///./msc_learning_assistant.db

# --- Auth ---
JWT_SECRET=my-local-dev-secret-12345

# --- SMS OTP (Twilio) --- leave blank to use console "DEV MODE" OTP printing
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- LLM (Claude) --- leave blank to use the offline excerpt-only fallback
ANTHROPIC_API_KEY=

# --- Storage paths ---
UPLOAD_DIR=./uploads
VECTORSTORE_DIR=./vectorstore
